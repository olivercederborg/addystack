#!/usr/bin/env bash
# Blocks a commit whose SKILL.md frontmatter is invalid or size passes the re-attach cap,
# whose skill names a skill in a higher layer, whose kit text names a user or a team, whose chat format pointer
# has drifted from shared/, whose core skill lacks shared/notes-line.md near its top,
# whose core/skills.json differs from the skill folders, whose copies (scripts/copies.txt)
# differ from their sources or left a symlink in the kit,
# whose built global/built/*.md file differs from its sources (in the workshop), whose
# example replies break reply-shape's layout, whose reply-rules payload passes 8,000
# characters, or whose touched skills' script tests fail on this machine.
# The kit's Dagger suites run once per push, in .githooks/pre-push; the preferences, preset,
# and workshop suites, which Dagger leaves out, run here on every commit.
# Enable once per clone:
#   git config core.hooksPath .githooks
set -euo pipefail
# Globs behave the same whatever a BASH_ENV file set before this line ran.
unset GLOBIGNORE
shopt -u nullglob failglob nocaseglob dotglob
root="$(git rev-parse --show-toplevel)"
"$root/scripts/check-frontmatter.sh"
"$root/scripts/check-skill-size.sh"
"$root/scripts/check-layers.py"
"$root/scripts/check-neutral.py"
"$root/scripts/check-links.py"
"$root/scripts/sync-format.sh" --check
"$root/scripts/sync-notes.py" --check
"$root/scripts/sync-skill-list.py" --check
# Copies are checked in what this commit records, not on disk: a source staged without
# its synced copy passes on disk. checkout-index honours GIT_INDEX_FILE, which git sets
# for a commit of named paths.
index_tree="$(mktemp -d)"
trap 'rm -rf "$index_tree"' EXIT
git checkout-index --all --ignore-skip-worktree-bits --prefix="$index_tree/"
"$index_tree/scripts/sync-copies.py" --check
# With core.symlinks off, checkout-index writes a staged link as a plain file, so the
# index's own modes catch one too.
staged_links="$(git ls-files --stage | awk '$1 == "120000" { print $4 }')"
if [[ -n "$staged_links" ]]; then
  echo "A staged symlink; list its target in scripts/copies.txt instead:" "$staged_links" >&2
  exit 1
fi
if [[ -x "$root/maintainer/build-global.py" ]]; then "$root/maintainer/build-global.py" --check; fi
"$root/scripts/check_examples.py"
"$root/scripts/check-reply-budget.py"
# The staged paths, read from the index before the unset below.
staged=()
while IFS= read -r -d '' path; do staged+=("$path"); done < <(git diff --cached --name-only --no-renames -z)
# Git runs hooks with GIT_DIR and its other repo-local variables set (always in a
# worktree); a test that runs `git init` would then reinitialize this repo instead.
unset $(git rev-parse --local-env-vars)

. "$root/.githooks/suites.sh"

# The host suites of the skills this commit touches, each its own scripts/, from the list
# read before the unset above. shared/'s, scripts/', and the hook tests run one test after
# another here, slower than Dagger runs them, so they run only at push (.githooks/pre-push),
# in Dagger's full set, so a suite that reads files outside its folder still runs before
# the branch reaches GitHub.
touched=()
while IFS= read -r -d '' path; do
  case $path in
    skills/preferences/* | skills/preset/*) continue ;;  # their suites run below on every commit
    skills/*/*/scripts/*) ;;
    # Markdown outside scripts/, which Dagger's skill checks leave out too (skill_source in
    # .dagger/src/skills/main.py), so a SKILL.md or reference edit runs no suite until push.
    skills/*/*/*.md) continue ;;
    skills/*/*/*) ;;
    *) continue ;;
  esac
  folder=${path#skills/}; folder="skills/${folder%%/*}/$(cut -d/ -f2 <<< "$folder")/scripts"
  [[ " ${touched[*]-} " == *" $root/$folder "* ]] || touched+=("$root/$folder")
done < <(printf '%s\0' "${staged[@]-}")
run_suites "${touched[@]-}"
# The suites the kit's Dagger module leaves out: the preferences and preset skills', which
# stay out of the release, and a workshop checkout's maintainer/'s. They run here whenever
# the checkout has them.
run_suites "$root"/skills/{preferences,preset}/*/scripts "$root"/maintainer
