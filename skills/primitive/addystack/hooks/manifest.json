    {"id": "ready-gate", "tags": ["safety"], "event": "PreToolUse", "matcher": "Bash", "command": "{{kit}}/hooks/ready-gate.py", "timeout": 60, "onFailure": "block"},
    {"id": "push-gate", "tags": ["safety"], "event": "PreToolUse", "matcher": "Bash", "command": "{{kit}}/hooks/push-gate.py", "timeout": 60, "onFailure": "block"},
    {"id": "child-fast-mode-off", "tags": ["workflow"], "event": "PreToolUse", "matcher": "mcp__t3-code__delegate_task|mcp__t3-code__create_threads|mcp__t3-code__t3_thread_launch", "command": "{{kit}}/hooks/child-fast-mode-off.py", "timeout": 10},
    {"id": "unwatch-gate", "tags": ["workflow"], "event": "PreToolUse", "matcher": "mcp__t3-code__unwatch_pull_request", "command": "{{kit}}/hooks/unwatch-gate.py", "timeout": 30, "onFailure": "block"},
    {"id": "skills-checkout-check", "tags": ["machine"], "event": "SessionStart", "matcher": null, "command": "{{kit}}/hooks/skills-checkout-check.py", "timeout": 10},
    {"id": "reply-shape-context", "tags": ["replies"], "requires": "replies.style=reply-shape", "event": "SessionStart", "matcher": null, "command": "{{kit}}/hooks/reply-shape-context.py", "timeout": 10},
    {"id": "reply-rules", "tags": ["replies"], "requires": "replies.rules", "event": "SessionStart", "matcher": null, "command": "{{kit}}/hooks/reply-shape-context.py --rules", "timeout": 10},
    {"id": "agent-memory-guard-notice", "tags": ["machine"], "event": "PostToolUseFailure", "matcher": "Bash", "command": "{{kit}}/hooks/agent-memory-guard-notice.py", "timeout": 10, "hosts": ["darwin"]},
    {"id": "watch-reminder", "tags": ["workflow"], "event": "PostToolUse", "matcher": "mcp__t3-code__pull_request_update|mcp__t3-code__pull_request_create|Bash", "command": "{{kit}}/hooks/watch-reminder.py", "timeout": 10}
,
    {"id": "cleanest-ask", "tags": ["trial"], "event": "Stop", "matcher": null, "command": "{{kit}}/hooks/cleanest-ask.py", "timeout": 30}
  ],
  "codex": [
