    {"id": "reply-rules", "tags": ["replies"], "requires": "replies.rules", "event": "SessionStart", "matcher": null, "command": "{{kit}}/hooks/reply-shape-context.py --rules", "timeout": 10},
    {"id": "skills-checkout-check", "tags": ["machine"], "event": "SessionStart", "matcher": null, "command": "{{kit}}/hooks/skills-checkout-check.py", "timeout": 10},
    {"id": "merge-gate", "tags": ["safety"], "event": "PreToolUse", "matcher": "Bash", "command": "{{kit}}/hooks/merge-gate.py", "timeout": 60},
    {"id": "ready-gate", "tags": ["safety"], "event": "PreToolUse", "matcher": "Bash", "command": "{{kit}}/hooks/ready-gate.py", "timeout": 60},
    {"id": "push-gate", "tags": ["safety"], "event": "PreToolUse", "matcher": "Bash", "command": "{{kit}}/hooks/push-gate.py", "timeout": 60}
  ]
