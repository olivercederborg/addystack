{
  "claude": [
    {"id": "keychain-home-guard", "tags": ["machine"], "event": "PreToolUse", "matcher": "Bash", "command": "{{kit}}/hooks/keychain-home-guard.py", "timeout": 10, "hosts": ["darwin"]},
